# ── OpenVibe.Media — environment ─────────────────────────────
# Copy to .env (or /etc/openvibe/media.env in production) and adjust.

# HTTP
PORT=4100
HOST=0.0.0.0
NODE_ENV=development
# Public base URL used when building absolute playback/asset URLs.
MEDIA_PUBLIC_URL=https://openvibe.media

# Database (better-sqlite3, WAL)
DB_PATH=./data/media.db

# Restore-drill mode, set only by `ovhost drill media` (OpenVibe.Host docs/restore-drills.md): reads
# only from a restored copy, no stored bytes, no jobs, webhooks, events or ffmpeg; refuses to start
# unless DB_PATH is outside the checkout, HOST is loopback and PORT is not 4100 (server/drill.js).
# MEDIA_DRILL=1

# Storage paths (all created on boot)
VOD_PATH=./data/vods
CLIPS_PATH=./data/clips
PASTES_PATH=./data/pastes
THUMBNAILS_PATH=./data/thumbnails
FILES_PATH=./data/files

# RTP ingest port pool (UDP, bound on 127.0.0.1 by ffmpeg)
RTP_PORT_MIN=12000
RTP_PORT_MAX=12199

# Identity provider (OpenVibe.Network) — JWKS fetched at boot for offline
# RS256 verification of user JWTs on browser endpoints.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# Per-service key for Network's /internal/* endpoints (header X-Internal-Key).
INTERNAL_API_KEY=

# ── Tenant (app) seeding ─────────────────────────────────────
# JSON array, upserted into the `apps` table on every boot (api_key is hashed,
# never stored in plaintext). allowed_origins guards browser (user-JWT) calls.
# MEDIA_APPS_SEED='[{"app_id":"live","name":"OpenVibe.Live","api_key":"change-me","webhook_url":"http://127.0.0.1:3000/api/media-webhook","webhook_secret":"change-me-too","allowed_origins":["https://openvibe.live"],"quota_bytes":0}]'
MEDIA_APPS_SEED=
# Fallback short form (no webhooks/origins): "live:key1,games:key2"
MEDIA_APP_KEYS=

# ── Developer-project tenants (ADR-014) ──────────────────────
# Created on first use by a developer app token (Network, audience openvibe.media) for its own
# project: /api/v1/prj_<ULID>/files, /api/v2/prj_<ULID>/objects. Default quotas in MB, applied
# when the tenant is created (change apps.quota_bytes afterwards to adjust one tenant).
MEDIA_APP_TENANT_QUOTA_MB=1024
MEDIA_APP_SANDBOX_QUOTA_MB=100

# ── Object storage tiering (optional; local-only when unset) ─
# Backblaze B2 (canonical cold tier)
MEDIA_B2_ENDPOINT=
MEDIA_B2_REGION=us-west-004
MEDIA_B2_BUCKET=
MEDIA_B2_KEY_ID=
MEDIA_B2_APP_KEY=
# Cloudflare R2 (popularity cache, free egress)
MEDIA_R2_ENDPOINT=
MEDIA_R2_REGION=auto
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=

# ── Recording knobs (defaults match the inherited recorder) ──
# VOD_STOP_GRACE_MS=60000
# VOD_DISK_WARN_GB=15
# VOD_DISK_CRIT_GB=5
# MAX_VOD_SIZE_MB=2048
# VOD_NO_NORMALIZE=0

# OpenVibe.Events (durable events): vod/clip/object/storage outcomes are also published through
# Media's outbox with the OAuth client credentials (grant events.event.publish). Unset = off.
#EVENTS_URL=http://127.0.0.1:4300

# ── Object uploads (docs/object-model.md#presigned-uploads, #multipart-uploads) ──
# MEDIA_SIGNING_SECRET signs presigned upload/download URLs; set it in production.
#MEDIA_SIGNING_SECRET=
#MEDIA_OBJECT_MAX_MB=256            # single-part limit; larger objects use multipart
#MEDIA_UPLOAD_TOKEN_TTL_S=3600      # default presigned upload URL lifetime
#MEDIA_MULTIPART_MAX_MB=20480
#MEDIA_MULTIPART_PART_MB=64         # bounds: MEDIA_MULTIPART_MIN_PART_MB=5, MEDIA_MULTIPART_MAX_PART_MB=256
#MEDIA_MULTIPART_TTL_HOURS=24
#MEDIA_UPLOAD_MIN_FREE_MB=10240     # free disk kept in reserve by multipart uploads and split/remux jobs

# ── Jobs (docs/object-model.md#jobs) ─────────────────────────
#MEDIA_JOBS_ENABLED=1
#MEDIA_JOBS_POLL_MS=5000
#MEDIA_JOBS_LIGHT_CONCURRENCY=2
#MEDIA_JOBS_HEAVY_CONCURRENCY=1
#MEDIA_JOBS_HEAVY_WHILE_RECORDING=0
#MEDIA_INVARIANT_SCAN_HOURS=24      # the size-invariant validator (proposes split/remux; never runs them)
