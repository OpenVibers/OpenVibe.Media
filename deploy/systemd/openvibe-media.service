# OpenVibe.Media — multi-tenant media service (VOD recording/serving, clips, pastes, files).
# Secrets live in /etc/openvibe/media.env (0600).
[Unit]
Description=OpenVibe.Media service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.media
EnvironmentFile=/etc/openvibe/media.env
ExecStart=/usr/bin/env node /opt/openvibe.media/server/index.js
Restart=always
RestartSec=3
# Recordings get VOD_STOP_GRACE_MS (60 s) to flush trailers and the process force-exits at 70 s;
# systemd must not SIGKILL before that, or a stop during a recording cuts the file.
TimeoutStopSec=80
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openvibe.media/data

[Install]
WantedBy=multi-user.target
